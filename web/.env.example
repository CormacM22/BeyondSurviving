# Copy to .env.local and fill in. Both values are public (safe in the browser).
# Local development: printed by `npx supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Eventbrite and WordPress secrets do NOT go here. They are Supabase function
# secrets, set with `npx supabase secrets set ...`, and never reach the browser.
